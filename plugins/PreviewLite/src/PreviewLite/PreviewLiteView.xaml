<UserControl x:Class="PreviewLite.PreviewLiteView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 MinWidth="640" MinHeight="550" Background="#252525" Foreground="#EEEEEE">
 <UserControl.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="0,0,10,8"/><Setter Property="Padding" Value="14,8"/><Setter Property="Foreground" Value="#222222"/><Setter Property="Background" Value="#EEEEEE"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#222222"/><Setter Property="Background" Value="#EEEEEE"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#222222"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="#EEEEEE">
  <StackPanel Margin="20">
   <TextBlock FontSize="22" Text="PreviewLite 0.3.0 · 試作版" Margin="0,0,0,12"/>
   <TextBlock TextWrapping="Wrap" Text="プレビューの更新回数を抑え、動画の読み込み・描画の頻度を減らします。動画全編のプロキシは作りません。" Margin="0,0,0,12"/>
   <TextBlock x:Name="ConnectionText" TextWrapping="Wrap" Foreground="#FFD887" Margin="0,0,0,12"/>
   <WrapPanel Margin="0,0,0,12">
    <StackPanel Margin="0,0,20,0"><TextBlock Text="再生中の更新頻度（目安）"/><ComboBox x:Name="PlaybackBox" Width="180" SelectedIndex="1" Margin="0,6,0,0"><ComboBoxItem Content="30 fps" Tag="30"/><ComboBoxItem Content="20 fps" Tag="20"/><ComboBoxItem Content="15 fps" Tag="15"/></ComboBox></StackPanel>
    <StackPanel><TextBlock Text="停止・編集中の更新頻度"/><ComboBox x:Name="IdleBox" Width="180" SelectedIndex="1" Margin="0,6,0,0"><ComboBoxItem Content="15 fps" Tag="15"/><ComboBoxItem Content="10 fps" Tag="10"/><ComboBoxItem Content="5 fps" Tag="5"/></ComboBox></StackPanel>
   </WrapPanel>
   <WrapPanel>
    <Button x:Name="EnableButton" Content="軽量化をON" Click="EnableClick"/>
    <Button Content="OFF・通常に戻す" Click="DisableClick"/>
    <Button x:Name="MeasureButton" Content="通常状態を計測" Click="MeasureClick"/>
   </WrapPanel>
   <TextBlock x:Name="ModeText" Text="OFF：通常のプレビュー" FontSize="16" Margin="0,8,0,12" TextWrapping="Wrap"/>
   <Border BorderBrush="#666666" BorderThickness="1" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="MetricsText" TextWrapping="Wrap" Text="計測待ち"/></Border>
   <TextBlock TextWrapping="Wrap" Foreground="#BBBBBB" Text="・画質／プロジェクトFPS／音声／書き出し設定は変更しません。&#10;・負荷低下と引き換えに、映像の動きや編集操作の反応は粗くなります。&#10;・重い1フレームの処理や動画切替時の待ち時間は残る場合があります。&#10;・このツールを閉じるとOFFになります。起動時も毎回OFFです。&#10;・他のプレビュー調整プラグインとの同時使用は避けてください。"/>
   <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="比較方法：通常状態を計測 → 同じ区間を再生 → ON → 同じ区間を再生。数値より音声と映像のずれ・体感も確認してください。"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
