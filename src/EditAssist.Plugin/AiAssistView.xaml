<UserControl x:Class="EditAssist.Plugin.AiAssistView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Unloaded="OnUnloaded">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TabControl x:Name="AiTabs">
   <TabItem Header="依頼・ChatGPT接続">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="InputsPanel" Margin="10">
     <TextBlock Text="場面説明・依頼（台本の作成／修正／短縮、素材候補の提案）"/>
     <TextBox x:Name="InstructionBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="OnInputChanged"/>
     <TextBlock Text="キャラ設定・口調・動画ジャンル・対象尺"/>
     <TextBox x:Name="CharactersBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="OnInputChanged"/>
     <Button Content="YMM4のキャラ名を取得" Click="OnCharacters"/>
     <GroupBox Header="ゆっくりの語尾・話し方" Margin="0,8">
      <StackPanel Margin="8">
       <CheckBox x:Name="UseManualStyleBox" Content="プロンプトで口調を指定する" Checked="OnInputChanged" Unchecked="OnInputChanged"/>
       <TextBox x:Name="ManualStyleBox" Height="85" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="OnInputChanged" ToolTip="例：霊夢：一人称は私。くだけた口調。語尾は～ね、～よ。魔理沙：一人称は私。語尾は～だぜ、～だな。語尾を毎回固定しない。"/>
       <CheckBox x:Name="UseLearnedStyleBox" Content="参考台本から抽出した話し方を使う" Checked="OnInputChanged" Unchecked="OnInputChanged"/>
       <WrapPanel><Button Content="CSV／TSV台本から抽出" Click="OnLearnStyleFile"/><Button Content="選択ボイスから抽出" Click="OnLearnStyleSelection"/></WrapPanel>
       <TextBlock Text="キャラごとに文末の傾向と例文を抽出します。AIモデル自体の再学習は行いません。確認・修正後、生成時の参考に使います。手動指定を優先します。" TextWrapping="Wrap"/>
       <TextBox x:Name="LearnedStyleBox" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnInputChanged"/>
       <WrapPanel><Button Content="口調設定を保存" Click="OnSaveStyle"/><Button Content="口調設定を読み込む" Click="OnLoadStyle"/><Button Content="抽出結果を消す" Click="OnClearLearnedStyle"/></WrapPanel>
      </StackPanel>
     </GroupBox>
     <TextBlock Text="下書き・既存セリフ（任意）"/>
     <TextBox x:Name="DraftBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="OnInputChanged"/>
     <Button Content="選択ボイスのセリフを下書きに取得" Click="OnDraft"/>
     <WrapPanel>
      <CheckBox x:Name="IncludeMaterialsBox" Content="登録素材の候補情報を含める" Checked="OnInputChanged" Unchecked="OnInputChanged" Margin="0,0,15,0"/>
      <TextBlock Text="素材の絞り込み"/><TextBox x:Name="MaterialQueryBox" Width="230" TextChanged="OnInputChanged"/>
     </WrapPanel>
     <TextBlock Text="素材を含める場合は名前・種類・タグ・説明・IDを最大200件渡します。動画・音源・ファイルパスは含めません。" TextWrapping="Wrap"/>
     <WrapPanel Margin="0,8"><Button Content="依頼文を作成" Click="OnPrompt"/><Button Content="依頼文をコピー" Click="OnCopy"/><Button Content="ChatGPTを開く" Click="OnOpenChatGpt"/></WrapPanel>
     <TextBox x:Name="PromptBox" Height="130" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
     <TextBlock Text="自動連携：ChatGPTでログイン済みのCodex CLI" FontWeight="SemiBold" Margin="0,12,0,0"/>
     <WrapPanel><TextBox x:Name="CliPathBox" Width="470" ToolTip="codex.exe または npmのcodex.cmdのフルパス"/><Button Content="CLIを選択" Click="OnBrowseCli"/></WrapPanel>
     <WrapPanel><TextBlock Text="モデル名（空欄はCLI標準）"/><TextBox x:Name="ModelBox" Width="220"/></WrapPanel>
     <CheckBox x:Name="SendConsentBox" Content="上記の依頼・キャラ設定・下書き・有効な口調設定と参考例文・素材候補を送信し、Codexの利用枠を使う" Margin="0,5"/>
     <Button x:Name="GenerateButton" Content="Codex経由で生成" Click="OnGenerate"/>
     <TextBlock Text="CLIは別途導入し、codex loginでChatGPTにログインしてください。APIキー方式はこの版では使いません。字幕調整はAIなしで利用できます。" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="返答の確認・編集へ渡す">
    <Grid Margin="10">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="ChatGPTのJSON返答を貼り付けるか、Codexで生成してください。内容確認後に台本編集へ渡します。" TextWrapping="Wrap"/>
     <TextBox Grid.Row="1" x:Name="ResponseBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnResponseChanged"/>
     <WrapPanel Grid.Row="2"><Button Content="返答を読み込んで確認" Click="OnImport"/><Button Content="JSONを開く" Click="OnOpenResult"/></WrapPanel>
     <TabControl Grid.Row="3">
      <TabItem Header="台本"><DataGrid x:Name="LinesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
       <DataGridTextColumn Header="キャラ" Binding="{Binding Character}" Width="150"/><DataGridTextColumn Header="セリフ" Binding="{Binding Text}" Width="*"/>
      </DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="素材候補"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DataGrid x:Name="MaterialsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
        <DataGridTextColumn Header="台本行" Binding="{Binding Line}" Width="65"/><DataGridTextColumn Header="素材名" Binding="{Binding Title}" Width="170"/><DataGridTextColumn Header="理由" Binding="{Binding Reason}" Width="*"/>
       </DataGrid.Columns></DataGrid><Button Grid.Row="1" Content="選んだ素材をライブラリで開く" Click="OnMaterial"/>
      </Grid></TabItem>
     </TabControl>
     <StackPanel Grid.Row="4">
      <TextBox x:Name="NotesBox" Height="65" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      <WrapPanel><Button Content="台本編集へ渡す" Click="OnTransfer"/><Button Content="台本CSVを保存" Click="OnSaveCsv"/></WrapPanel>
     </StackPanel>
    </Grid>
   </TabItem>
  </TabControl>
  <WrapPanel Grid.Row="1"><Button x:Name="CancelButton" Content="AI生成を中止" IsEnabled="False" Click="OnCancel"/><TextBlock x:Name="StatusText" Width="700" TextWrapping="Wrap" VerticalAlignment="Center" Text="AIからの返答を検証してから使います。タイムラインへは自動適用しません。"/></WrapPanel>
 </Grid>
</UserControl>
